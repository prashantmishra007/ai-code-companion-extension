{
  "name": "dev-refactor-ai",
  "displayName": "AI Copilot Companion",
  "description": "Commercial-grade AI Coding Assistant powered by Gemini 3.8 Flash",
  "version": "0.0.4",
  "publisher": "prashant-kumar",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Machine Learning",
    "SCM Providers"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "AI Copilot Companion",
      "properties": {
        "aiCompanion.debounceDelay": {
          "type": "number",
          "default": 400,
          "description": "Inline autocomplete debounce delay in milliseconds."
        },
        "aiCompanion.securityScanOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically scan files for hardcoded secrets and API keys on save."
        }
      }
    },
    "commands": [
      {
        "command": "ai-companion.inlineChat",
        "title": "✨ Gemini: Inline Edit / Chat (Cursor Style)"
      },
      {
        "command": "ai-companion.generateCommitMessage",
        "title": "✨ Gemini: Generate AI Git Commit Message",
        "icon": "$(sparkle)"
      },
      {
        "command": "ai-companion.fixTerminalError",
        "title": "✨ Gemini: Fix Terminal Error"
      },
      {
        "command": "ai-companion.generateBoilerplate",
        "title": "✨ Gemini: Generate Boilerplate / Scaffold File"
      },
      {
        "command": "ai-companion.toggleCompletions",
        "title": "Gemini: Toggle Inline Suggestions"
      },
      {
        "command": "ai-companion.generateTests",
        "title": "✨ Gemini: Generate Unit Tests"
      },
      {
        "command": "ai-companion.addDocstring",
        "title": "✨ Gemini: Add Documentation / JSDoc"
      },
      {
        "command": "ai-companion.fixCode",
        "title": "✨ Gemini: Fix & Refactor Selection"
      },
      {
        "command": "ai-companion.explainCode",
        "title": "✨ Gemini: Explain Selected Code"
      }
    ],
    "keybindings": [
      {
        "command": "ai-companion.inlineChat",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus"
      },
      {
        "command": "ai-companion.toggleCompletions",
        "key": "alt+\\",
        "mac": "alt+\\"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "ai-companion.inlineChat",
          "group": "7_modification@0"
        },
        {
          "command": "ai-companion.generateTests",
          "when": "editorHasSelection",
          "group": "7_modification@1"
        },
        {
          "command": "ai-companion.addDocstring",
          "when": "editorHasSelection",
          "group": "7_modification@2"
        },
        {
          "command": "ai-companion.fixCode",
          "when": "editorHasSelection",
          "group": "7_modification@3"
        },
        {
          "command": "ai-companion.explainCode",
          "when": "editorHasSelection",
          "group": "7_modification@4"
        }
      ],
      "scm/title": [
        {
          "command": "ai-companion.generateCommitMessage",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ai-assistant-sidebar",
          "title": "AI Assistant",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "ai-assistant-sidebar": [
        {
          "type": "webview",
          "id": "ai-assistant.view",
          "name": "AI Copilot Companion",
          "icon": "media/icon.svg"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.5"
  }
}