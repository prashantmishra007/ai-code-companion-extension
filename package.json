{
  "name": "dev-refactor-ai",
  "displayName": "AI Copilot Companion",
  "description": "AI Coding Assistant and Copilot powered by Gemini 3.8 Flash",
  "version": "0.0.1",
  "publisher": "prashant-kumar",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Machine Learning"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ai-companion.toggleCompletions",
        "title": "Gemini: Toggle Inline Suggestions"
      },
      {
        "command": "ai-companion.generateTests",
        "title": "✨ Gemini: Generate Unit Tests"
      },
      {
        "command": "ai-companion.addDocstring",
        "title": "✨ Gemini: Add Documentation / JSDoc"
      },
      {
        "command": "ai-companion.fixCode",
        "title": "✨ Gemini: Fix & Refactor Selection"
      },
      {
        "command": "ai-companion.explainCode",
        "title": "✨ Gemini: Explain Selected Code"
      }
    ],
    "keybindings": [
      {
        "command": "ai-companion.toggleCompletions",
        "key": "alt+\\",
        "mac": "alt+\\"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "ai-companion.generateTests",
          "when": "editorHasSelection",
          "group": "7_modification@1"
        },
        {
          "command": "ai-companion.addDocstring",
          "when": "editorHasSelection",
          "group": "7_modification@2"
        },
        {
          "command": "ai-companion.fixCode",
          "when": "editorHasSelection",
          "group": "7_modification@3"
        },
        {
          "command": "ai-companion.explainCode",
          "when": "editorHasSelection",
          "group": "7_modification@4"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ai-assistant-sidebar",
          "title": "AI Assistant",
          "icon": "media/gemini-icon.svg"
        }
      ]
    },
    "views": {
      "ai-assistant-sidebar": [
        {
          "type": "webview",
          "id": "ai-assistant.view",
          "name": "AI Copilot Companion",
          "icon": "media/gemini-icon.svg"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.14.1",
    "eslint": "^8.57.0",
    "typescript": "^5.4.5"
  }
}