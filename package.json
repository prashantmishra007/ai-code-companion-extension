{
  "name": "dev-refactor-ai",
  "displayName": "AI Code Fixer & Refactor",
  "description": "AI code fixer, refactor, and summarizer engine",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ai-assistant-sidebar",
          "title": "AI Assistant",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "ai-assistant-sidebar": [
        {
          "type": "webview",
          "id": "ai-assistant.view",
          "name": "AI Code Companion",
          "icon": "media/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "dev-refactor-ai.fixCode",
        "title": "AI: Fix & Refactor Selected Code"
      }
    ],
    "keybindings": [
      {
        "command": "dev-refactor-ai.fixCode",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f",
        "when": "editorHasSelection"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "dev-refactor-ai.fixCode",
          "when": "editorHasSelection",
          "group": "modification"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "axios": "^1.20.0"
  }
}